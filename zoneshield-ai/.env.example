# ZoneShield AI environment variables
# Copy to .env and customize

ZONESHIELD_ENV=dev
ZONESHIELD_AGENT_MODE=mock          # mock | bedrock
ZONESHIELD_DB_BACKEND=sqlite       # sqlite | dynamodb
ZONESHIELD_BEDROCK_MODEL_ID=       # set when using bedrock
ZONESHIELD_AWS_REGION=us-east-1
ZONESHIELD_DB_PATH=data/zoneshield.db
ZONESHIELD_EVIDENCE_PATH=data/evidence
ZONESHIELD_LOG_LEVEL=INFO
ZONESHIELD_IDLE_STOP_MINUTES=30
ZONESHIELD_MAX_DAILY_USD=10.0